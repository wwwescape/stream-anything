<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup on Android 11 and lower (see data_extraction_rules.xml for 12+). Only the user's
     preferences are backed up — the watch history and Play on TV pairings (their own DataStore
     files, with pairing keys in the Keystore) stay on this device. -->
<full-backup-content>
    <include domain="file" path="datastore/settings.preferences_pb" />
    <include domain="sharedpref" path="theme_prefs_sync.xml" />
</full-backup-content>
