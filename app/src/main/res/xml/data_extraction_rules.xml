<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup/transfer rules — same scope as backup_rules.xml: preferences only. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/settings.preferences_pb" />
        <include domain="sharedpref" path="theme_prefs_sync.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/settings.preferences_pb" />
        <include domain="sharedpref" path="theme_prefs_sync.xml" />
    </device-transfer>
</data-extraction-rules>
